---
import { DEFAULT_ZETA, ZETA_MAX, ZETA_MIN } from '../lib/spring';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="contact">
      <p class="sign">Liam Imagawa</p>
      <p class="mono links">
        <a class="link" href="mailto:liamimagawa@gmail.com">liamimagawa@gmail.com</a>
        <a class="link" href="https://github.com/LiamI16">github.com/LiamI16</a>
      </p>
    </div>

    <div class="tuner" data-motion-tuner>
      <svg class="step" viewBox="0 0 120 40" aria-hidden="true">
        <line class="ref" x1="0" y1="10" x2="120" y2="10"></line>
        <polyline data-step-path></polyline>
      </svg>
      <div class="controls">
        <label class="mono" for="zeta">
          Site motion <span class="readout">ζ = <output data-zeta-out>{DEFAULT_ZETA.toFixed(2)}</output></span>
        </label>
        <input
          id="zeta"
          type="range"
          min={ZETA_MIN}
          max={ZETA_MAX}
          step="0.05"
          value={DEFAULT_ZETA}
          data-zeta-input
          aria-describedby="zeta-hint"
        />
        <p id="zeta-hint" class="mono hint" data-zeta-hint>Every animation is this step response.</p>
      </div>
    </div>

    <p class="mono colophon">© {year} · Built with Astro</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-deep);
    border-top: 1px solid var(--line-soft);
  }

  .inner {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem 3rem;
    align-items: end;
  }

  @media (min-width: 760px) {
    .inner {
      grid-template-columns: 1fr auto;
    }

    .colophon {
      grid-column: 1 / -1;
    }
  }

  .sign {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0;
  }

  .links a {
    color: var(--ink-soft);
  }

  .tuner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .step {
    width: 120px;
    height: 40px;
    flex: none;
    overflow: visible;
  }

  .step .ref {
    stroke: var(--line);
    stroke-dasharray: 2 3;
  }

  .step polyline {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .controls {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .controls label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink);
  }

  .readout {
    color: var(--accent);
  }

  input[type='range'] {
    width: 100%;
    min-width: 11rem;
    margin: 0;
    accent-color: var(--accent);
  }

  .hint {
    margin: 0;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .colophon {
    margin: 0;
    color: var(--muted);
  }
</style>

<script>
  import { DEFAULT_ZETA, overshoot, springEasing, springSamples } from '../lib/spring';

  function read(key: string) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function write(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
    } catch {
      // Storage unavailable — the setting lasts for this page view.
    }
  }

  function describe(zeta: number) {
    if (zeta < 0.999) return `Underdamped · ${(overshoot(zeta) * 100).toFixed(1)}% overshoot`;
    if (zeta <= 1.001) return 'Critically damped · no overshoot';
    return 'Overdamped · sluggish on purpose';
  }

  function render(root: HTMLElement, zeta: number) {
    const samples = springSamples(zeta, 60);
    // y = 10 is the setpoint, y = 38 is zero; leave headroom for overshoot.
    const points = samples.map((v, i) => `${((i / 60) * 120).toFixed(1)},${(38 - v * 28).toFixed(1)}`).join(' ');
    root.querySelector('[data-step-path]')?.setAttribute('points', points);
    const out = root.querySelector('[data-zeta-out]');
    if (out) out.textContent = zeta.toFixed(2);
    const hint = root.querySelector('[data-zeta-hint]');
    if (hint) hint.textContent = describe(zeta);
  }

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-motion-tuner]');
    const input = root?.querySelector<HTMLInputElement>('[data-zeta-input]');
    if (!root || !input) return;

    const stored = Number(read('motion-zeta'));
    const zeta = Number.isFinite(stored) && stored > 0 ? stored : DEFAULT_ZETA;
    input.value = String(zeta);
    render(root, zeta);

    input.addEventListener('input', () => {
      const value = Number(input.value);
      const easing = springEasing(value);
      document.documentElement.style.setProperty('--ease-spring', easing);
      render(root, value);
      write('motion-zeta', String(value));
      write('motion-easing', easing);
    });
  });
</script>
