---
// Tree: on the home page the hero's trajectory doesn't stop at the hero. Scroll, and the head
// leaves the limit cycle and continues down a spine through the work section; each project
// grows off it as a leaf when the head reaches it.
//
// Seamlessness rules this file is built around:
// - One unified path: the head's own future trajectory (integrated from its exact state by the
//   portrait), then a tangent-continuous connector, then the spine. The head's position along
//   it is a single number `u`, spring-smoothed and speed-capped, so it can never jump.
// - Everything is drawn in document space (an SVG and a DOM head inside `.home`), so it scrolls
//   with the page exactly like the portrait and the cards — no frame-late fixed overlay. On
//   navigation it crossfades out with the page while the clicked cover morphs into the article.
// - Nothing ahead of the head is drawn. Growth is permanent: the visited spine stays (dimmer
//   below the head) and leaves never un-grow; only the head moves back up.
// - The spine is a natural cubic spline x(y) through gentle leans toward each leaf: C² and
//   single-valued in y, so it is smooth and cusp-free by construction.
---

<svg class="tree-svg" data-tree-svg aria-hidden="true">
  <path class="ghost" data-tree-ghost></path>
  <path class="dim" data-tree-dim></path>
  <g data-tree-branches></g>
  <path class="strong" data-tree-strong></path>
</svg>
<span class="tracer home-tracer" data-tree-tracer aria-hidden="true"></span>

<style>
  .tree-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 2;
    color: var(--accent);
  }

  .tree-svg :global(path) {
    fill: none;
    stroke: currentColor;
    stroke-linejoin: round;
    stroke-linecap: butt;
  }

  /* Matches the newest segment of the portrait's trail, so the handoff has no seam. */
  .strong {
    stroke-width: 1.75;
    stroke-opacity: 0.9;
  }

  .dim,
  .ghost {
    stroke-width: 1.25;
    stroke-opacity: 0.28;
  }

  .tree-svg :global(.branch) {
    stroke-width: 1.25;
    stroke-opacity: 0.5;
    stroke-linecap: round;
    transition: stroke-opacity var(--dur-fast) var(--ease-out);
  }

  .tree-svg :global(.branch.on) {
    stroke-opacity: 0.9;
  }

  .tree-svg :global(.node) {
    fill: currentColor;
    fill-opacity: 0.55;
    transition: fill-opacity var(--dur-fast) var(--ease-out);
  }

  .tree-svg :global(.node.on) {
    fill-opacity: 1;
  }

  .home-tracer {
    position: absolute;
    z-index: 3;
  }
</style>

<script>
  type Pt = { x: number; y: number };
  type Plan = { pts: Pt[]; dir: Pt };
  type Leaf = {
    li: HTMLElement;
    card: HTMLElement;
    index: number;
    side: number; // -1 grows left of the spine, +1 right
    cardY: number; // document y where the branch meets the cover
    nodeY: number; // document y where the branch leaves the spine
    coverTop: number; // document y of the top of the cover: crossing ARRIVE_AT calls the head here
    edgeX: number; // document x of the cover edge facing the spine
    g: number; // branch growth 0..1
    branch: SVGPathElement;
    node: SVGCircleElement;
  };

  const READ_AT = 0.58; // the head rides the spine at this fraction of the viewport (hero → first leaf)
  // On the spine the head moves in steps, one leaf at a time: a leaf is reached when its branch
  // node rises past ARRIVE_AT of the viewport, and released when it sinks back below RELEASE_AT.
  // Keyed to the node (not the cover) so the head always lands on screen.
  const ARRIVE_AT = 0.9;
  const RELEASE_AT = 0.97;
  // Focus steps in scroll order: the newest grown card takes focus once its centre rises above
  // FOCUS_ON of the viewport, and keeps it until that centre sinks back below FOCUS_OFF.
  const FOCUS_ON = 0.62;
  const FOCUS_OFF = 0.7;
  const ESCAPE_SPAN = 360; // px of scroll over which the head travels from the loop to the spine
  const LEAN = 10; // px the spine leans toward each leaf
  const JOIN = 90; // the spine starts this far below the hero divider, so the path enters it gently
  const NODE_ABOVE = 34; // a branch leaves the spine this far above the cover's midline
  const BRANCH_S = 0.26; // seconds for a branch to draw
  const CARD_AT = 0.3; // branch progress at which the card starts to unfold
  const OMEGA = 15; // head spring (critically damped), rad/s — a one-leaf step settles in ~0.35s
  const MAX_SPEED = 2200; // px/s along the path — the head can lag, never jump
  const GHOST_S = 0.5; // fade of the visited connector after the head rejoins the loop
  const STATE_KEY = 'tree:state';
  const NS = 'http://www.w3.org/2000/svg';

  const shared = window as typeof window & {
    __phaseHead?: Pt;
    __phaseHandoff?: number;
    __phaseTracer?: Pt;
    __phasePlan?: () => Plan;
  };
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const f1 = (n: number) => n.toFixed(1);

  function docOffset(el: HTMLElement): Pt {
    // Offset chain ignores transforms (leaves are mid-unfold when measured).
    let x = 0;
    let y = 0;
    for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) {
      x += n.offsetLeft;
      y += n.offsetTop;
    }
    return { x, y };
  }

  /** Natural cubic spline x(y) through points with strictly increasing y. */
  function naturalSpline(pts: Pt[]) {
    const n = pts.length;
    const ys = pts.map((p) => p.y);
    const xs = pts.map((p) => p.x);
    const M = new Array<number>(n).fill(0);
    if (n > 2) {
      const a = new Array<number>(n).fill(0);
      const b = new Array<number>(n).fill(0);
      const c = new Array<number>(n).fill(0);
      const d = new Array<number>(n).fill(0);
      for (let i = 1; i < n - 1; i++) {
        const h0 = ys[i] - ys[i - 1];
        const h1 = ys[i + 1] - ys[i];
        a[i] = h0;
        b[i] = 2 * (h0 + h1);
        c[i] = h1;
        d[i] = 6 * ((xs[i + 1] - xs[i]) / h1 - (xs[i] - xs[i - 1]) / h0);
      }
      for (let i = 2; i < n - 1; i++) {
        const w = a[i] / b[i - 1];
        b[i] -= w * c[i - 1];
        d[i] -= w * d[i - 1];
      }
      for (let i = n - 2; i >= 1; i--) M[i] = (d[i] - c[i] * M[i + 1]) / b[i];
    }
    const locate = (y: number) => {
      const yy = clamp(y, ys[0], ys[n - 1]);
      let i = 0;
      while (i < n - 2 && yy > ys[i + 1]) i++;
      const h = ys[i + 1] - ys[i];
      return { i, h, A: (ys[i + 1] - yy) / h, B: (yy - ys[i]) / h };
    };
    return {
      x(y: number) {
        const { i, h, A, B } = locate(y);
        return A * xs[i] + B * xs[i + 1] + (((A * A * A - A) * M[i] + (B * B * B - B) * M[i + 1]) * h * h) / 6;
      },
      slope(y: number) {
        const { i, h, A, B } = locate(y);
        return (xs[i + 1] - xs[i]) / h - ((3 * A * A - 1) / 6) * h * M[i] + ((3 * B * B - 1) / 6) * h * M[i + 1];
      },
    };
  }

  function cubic(p0: Pt, p1: Pt, p2: Pt, p3: Pt, t: number): Pt {
    const u = 1 - t;
    return {
      x: u * u * u * p0.x + 3 * u * u * t * p1.x + 3 * u * t * t * p2.x + t * t * t * p3.x,
      y: u * u * u * p0.y + 3 * u * u * t * p1.y + 3 * u * t * t * p2.y + t * t * t * p3.y,
    };
  }

  function setHandoff(value: number) {
    if ((shared.__phaseHandoff ?? 0) === value) return;
    shared.__phaseHandoff = value;
    window.dispatchEvent(new Event('phase:handoff')); // the portrait redraws synchronously
  }

  function run(home: HTMLElement, tree: HTMLElement, svg: SVGSVGElement, tracer: HTMLElement): () => void {
    const strongEl = svg.querySelector<SVGPathElement>('[data-tree-strong]')!;
    const dimEl = svg.querySelector<SVGPathElement>('[data-tree-dim]')!;
    const ghostEl = svg.querySelector<SVGPathElement>('[data-tree-ghost]')!;
    const branchesEl = svg.querySelector<SVGGElement>('[data-tree-branches]')!;
    const leavesEl = tree.querySelector<HTMLElement>('.leaves')!;
    const hero = document.querySelector<HTMLElement>('.hero');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const softNav = document.documentElement.hasAttribute('data-soft-nav');
    const pagePath = location.pathname;

    let H = 0;
    let homeX = 0; // document offset of .home (SVG and head coordinates are relative to it)
    let homeY = 0;
    let y0 = 0; // document y where the spine starts: the hero's bottom divider
    let yEnd = 0;
    let spline = naturalSpline([
      { x: 0, y: 0 },
      { x: 0, y: 1 },
    ]);
    let leaves: Leaf[] = [];
    let introBox: { right: number; bottom: number } | null = null; // hero text, which the path routes around

    // The head.
    let plan: Plan | null = null;
    let path: { pts: Pt[]; cum: number[]; L: number } | null = null;
    let escaped = false;
    let u = 0; // position along the unified path (px of arc length; spine part measured in y)
    let uv = 0;
    let visitedU = 0; // furthest u reached in this escape
    let spineVisited = -Infinity; // furthest document y the head has reached on the spine (ever)
    let ghostA = 0;
    let current = -1;
    let reached = 0; // leaves (in spine order) the head has been called to
    let focusIdx = -1;
    let lastDraw = '';
    let raf = 0;
    let lastT = 0;
    let lastSy = window.scrollY;

    const escStart = () => y0 - ESCAPE_SPAN;

    function measure() {
      H = window.innerHeight;
      const sy = window.scrollY;
      const hr = home.getBoundingClientRect();
      homeX = hr.left + window.scrollX;
      homeY = hr.top + sy;

      const lr = leavesEl.getBoundingClientRect();
      const cols = getComputedStyle(leavesEl).gridTemplateColumns.split(' ').map(parseFloat);
      const desktop = cols.length >= 3;
      const spineX = (desktop ? lr.left + cols[0] + cols[1] / 2 : lr.left + cols[0] / 2) + window.scrollX;
      y0 = hero ? hero.getBoundingClientRect().bottom + sy + JOIN : lr.top + sy - 40;

      // Extent of the hero's actual text (line boxes, not full-width blocks) and buttons. Bottom
      // from layout, since the entrance animation translates lines while it plays.
      const intro = hero?.querySelector<HTMLElement>('.intro');
      introBox = null;
      if (intro) {
        let right = -Infinity;
        const walker = document.createTreeWalker(intro, NodeFilter.SHOW_TEXT);
        const range = document.createRange();
        for (let n = walker.nextNode(); n; n = walker.nextNode()) {
          if (!n.textContent?.trim()) continue;
          range.selectNodeContents(n);
          for (const r of range.getClientRects()) right = Math.max(right, r.right);
        }
        for (const el of intro.querySelectorAll<HTMLElement>('.button, .link')) right = Math.max(right, el.getBoundingClientRect().right);
        if (Number.isFinite(right)) introBox = { right: right + window.scrollX, bottom: docOffset(intro).y + intro.offsetHeight };
      }

      const byIndex = new Map(leaves.map((l) => [l.index, l]));
      leaves = [...tree.querySelectorAll<HTMLElement>('[data-leaf]')]
        .map((li) => {
          const index = Number(li.dataset.leaf);
          const cover = li.querySelector<HTMLElement>('.cover')!;
          const { x, y } = docOffset(cover);
          const side = desktop && li.classList.contains('left') ? -1 : 1;
          const cardY = y + cover.offsetHeight * 0.5;
          const prev = byIndex.get(index);
          let branch = prev?.branch;
          let node = prev?.node;
          if (!branch || !node) {
            branch = document.createElementNS(NS, 'path');
            branch.setAttribute('class', 'branch');
            node = document.createElementNS(NS, 'circle');
            node.setAttribute('class', 'node');
            branchesEl.append(branch, node);
          }
          return {
            li,
            card: li.querySelector<HTMLElement>('.card')!,
            index,
            side,
            cardY,
            nodeY: cardY - (desktop ? NODE_ABOVE : 22),
            coverTop: y,
            edgeX: side < 0 ? x + cover.offsetWidth : x,
            g: prev?.g ?? 0,
            branch,
            node,
          };
        })
        .sort((a, b) => a.nodeY - b.nodeY);

      const pts: Pt[] = [{ x: spineX, y: y0 }];
      for (const l of leaves) {
        if (l.nodeY > pts[pts.length - 1].y + 24) pts.push({ x: spineX + l.side * (desktop ? LEAN : 3), y: l.nodeY });
      }
      const bottom = leaves.length ? Math.max(...leaves.map((l) => docOffset(l.li).y + l.li.offsetHeight)) : y0 + 200;
      yEnd = Math.max(bottom, pts[pts.length - 1].y + 60);
      pts.push({ x: spineX, y: yEnd });
      spline = naturalSpline(pts);

      if (plan) buildPath(plan);
      lastDraw = '';
    }

    /**
     * The head's own future trajectory, then a connector tangent to it and to the spine (G1 at
     * both joints). If the spine lies left of the hero text and the loop's exit sits above the
     * text's bottom, the connector first drops below the text via a waypoint, so it never
     * crosses a word or button.
     */
    function buildPath(p: Plan) {
      const S = { x: spline.x(y0), y: y0 };
      const s0 = spline.slope(y0);
      const tl = Math.hypot(s0, 1);
      const T = { x: s0 / tl, y: 1 / tl };
      const E = p.pts[p.pts.length - 1];
      const pts = p.pts.slice();
      const seg = (A: Pt, dA: Pt, B: Pt, dB: Pt) => {
        const k = clamp(Math.hypot(B.x - A.x, B.y - A.y) * 0.38, 16, 240);
        const c1 = { x: A.x + dA.x * k, y: A.y + dA.y * k };
        const c2 = { x: B.x - dB.x * k, y: B.y - dB.y * k };
        for (let i = 1; i <= 40; i++) pts.push(cubic(A, c1, c2, B, i / 40));
      };
      if (introBox && S.x < introBox.right + 24 && E.y < introBox.bottom + 32) {
        const Wp = { x: Math.max(S.x + 40, Math.min(E.x - 24, introBox.right + 36)), y: introBox.bottom + 44 };
        const tx = S.x - E.x;
        const ty = S.y - E.y;
        const tm = Math.hypot(tx, ty) || 1;
        const TW = { x: tx / tm, y: ty / tm };
        seg(E, p.dir, Wp, TW);
        seg(Wp, TW, S, T);
      } else {
        seg(E, p.dir, S, T);
      }
      const cum = [0];
      for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y));
      path = { pts, cum, L: cum[cum.length - 1] };
    }

    const atBottom = (sy: number) => sy + H >= document.documentElement.scrollHeight - 4;

    function readLine(sy: number) {
      if (atBottom(sy)) return yEnd; // bottom: reach every leaf
      return Math.min(sy + H * READ_AT, yEnd);
    }

    /** Which leaves have called the head, from where their covers sit in the viewport. */
    function updateReached(sy: number) {
      if (atBottom(sy)) {
        reached = leaves.length;
        return;
      }
      while (reached < leaves.length && leaves[reached].nodeY <= sy + H * ARRIVE_AT) reached++;
      while (reached > 0 && leaves[reached - 1].nodeY > sy + H * RELEASE_AT) reached--;
    }

    function targetU(readY: number, sy: number) {
      const L = path!.L;
      if (reached > 0) {
        // Stepped: rest on the latest reached leaf's node (the spine's end once at the bottom).
        const y = atBottom(sy) ? yEnd : leaves[reached - 1].nodeY;
        return L + (y - y0);
      }
      if (readY <= escStart()) return 0;
      if (readY < y0) return ((readY - escStart()) / ESCAPE_SPAN) * L;
      // Before the first leaf calls, follow the scroll — but never past the first node.
      return L + (Math.min(readY, leaves[0]?.nodeY ?? yEnd) - y0);
    }

    function pointAt(uu: number): Pt {
      const { pts, cum, L } = path!;
      if (uu >= L) {
        const y = Math.min(y0 + (uu - L), yEnd);
        return { x: spline.x(y), y };
      }
      let lo = 0;
      let hi = cum.length - 1;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (cum[mid] <= uu) lo = mid;
        else hi = mid;
      }
      const t = clamp((uu - cum[lo]) / (cum[hi] - cum[lo] || 1), 0, 1);
      return { x: pts[lo].x + (pts[hi].x - pts[lo].x) * t, y: pts[lo].y + (pts[hi].y - pts[lo].y) * t };
    }

    // ── SVG path strings (coordinates relative to .home) ───────────────────
    const P = (p: Pt, cmd: string) => `${cmd}${f1(p.x - homeX)} ${f1(p.y - homeY)}`;

    function connectorD(a: number, b: number) {
      if (!path || b - a < 0.05) return '';
      const { pts, cum } = path;
      let d = P(pointAt(a), 'M');
      for (let i = 0; i < pts.length; i++) if (cum[i] > a && cum[i] < b) d += P(pts[i], 'L');
      return d + P(pointAt(b), 'L');
    }

    function spineD(a: number, b: number, move: boolean) {
      a = Math.max(a, y0);
      b = Math.min(b, yEnd);
      if (b - a < 0.05) return '';
      let d = '';
      for (let y = a; ; y += 4) {
        const yy = Math.min(y, b);
        d += P({ x: spline.x(yy), y: yy }, d || !move ? 'L' : 'M');
        if (yy >= b) break;
      }
      return d;
    }

    function escape(sy: number, instant: boolean) {
      const p = shared.__phasePlan ? shared.__phasePlan() : hero ? null : { pts: [{ x: spline.x(y0), y: escStart() }], dir: { x: 0, y: 1 } };
      if (!p) return; // portrait not mounted yet; try again next frame
      plan = p;
      buildPath(p);
      escaped = true;
      ghostA = 0;
      u = instant ? targetU(readLine(sy)) : 0;
      uv = 0;
      visitedU = u;
      setHandoff(1);
    }

    function rejoin() {
      ghostEl.setAttribute('d', connectorD(0, Math.min(visitedU, path!.L)));
      ghostA = 1;
      escaped = false;
      plan = null;
      path = null;
      u = uv = visitedU = 0;
      setHandoff(0);
    }

    function growLeaves(dt: number, instant: boolean) {
      for (const l of leaves) {
        // The head settles onto a node asymptotically, so arrival is "within a pixel and a half".
        if (l.g === 0 && spineVisited >= l.nodeY - 1.5) l.g = instant || reduceMotion ? 1 : 1e-4;
        else if (l.g > 0 && l.g < 1) l.g = Math.min(1, l.g + dt / BRANCH_S);
        if (l.g >= CARD_AT && !l.li.hasAttribute('data-grown')) {
          if (instant) {
            l.li.setAttribute('data-instant', '');
            requestAnimationFrame(() => requestAnimationFrame(() => l.li.removeAttribute('data-instant')));
          }
          l.li.setAttribute('data-grown', '');
        }
      }
    }

    function draw(dt: number) {
      const headU = escaped ? u : 0;
      const L = path?.L ?? 0;
      const headY = escaped && u > L ? y0 + (u - L) : -Infinity;
      const anim = leaves.some((l) => l.g > 0 && l.g < 1);
      const key = `${escaped}|${f1(headU)}|${f1(visitedU)}|${f1(spineVisited)}|${current}|${f1(homeY)}|${f1(y0)}|${f1(yEnd)}`;

      if (ghostA > 0) {
        ghostA = reduceMotion ? 0 : Math.max(0, ghostA - dt / GHOST_S);
        ghostEl.style.opacity = ghostA.toFixed(3);
        if (ghostA === 0) ghostEl.setAttribute('d', '');
      }
      if (key === lastDraw && !anim) return;
      lastDraw = key;

      // Behind the head: the escape path, then the spine down to the head.
      let strong = '';
      if (escaped && path) {
        strong = connectorD(0, Math.min(headU, L));
        if (headU > L) strong += spineD(y0, headY, !strong);
      }
      strongEl.setAttribute('d', strong);

      // Visited but below the head: dim. Never anything the head hasn't reached.
      let dim = '';
      if (escaped && path && headU < L) dim = connectorD(headU, Math.min(visitedU, L));
      const dimFrom = escaped && headU > L ? headY : y0;
      if (spineVisited > dimFrom) {
        const s = spineD(dimFrom, spineVisited, true);
        dim += s;
      }
      dimEl.setAttribute('d', dim);

      for (const l of leaves) {
        if (l.g <= 0) {
          l.branch.setAttribute('d', '');
          l.node.setAttribute('r', '0');
          continue;
        }
        const P0 = { x: spline.x(l.nodeY), y: l.nodeY };
        const s = spline.slope(l.nodeY);
        const tl = Math.hypot(s, 1);
        const P3 = { x: l.edgeX - l.side * 6, y: l.cardY };
        const k1 = Math.min(18, (l.cardY - l.nodeY) * 0.5);
        const k2 = Math.min(18, Math.abs(P3.x - P0.x) * 0.45);
        const P1 = { x: P0.x + (s / tl) * k1, y: P0.y + (1 / tl) * k1 };
        const P2 = { x: P3.x - l.side * k2, y: l.cardY };
        let d = '';
        const steps = 24;
        for (let i = 0; i <= steps; i++) d += P(cubic(P0, P1, P2, P3, (i / steps) * l.g), i ? 'L' : 'M');
        l.branch.setAttribute('d', d);
        const on = l.index === current;
        l.branch.classList.toggle('on', on);
        l.node.classList.toggle('on', on);
        l.node.setAttribute('cx', f1(P0.x - homeX));
        l.node.setAttribute('cy', f1(P0.y - homeY));
        l.node.setAttribute('r', on ? '3' : '2.5');
      }
    }

    function place() {
      if (!escaped || !path) {
        tracer.style.opacity = '0';
        shared.__phaseTracer = undefined;
        return;
      }
      const p = pointAt(u);
      shared.__phaseTracer = p;
      tracer.style.opacity = '1';
      tracer.style.transform = `translate3d(${(p.x - homeX).toFixed(2)}px, ${(p.y - homeY).toFixed(2)}px, 0)`;
    }

    /** Focus: the newest grown card whose centre has risen past FOCUS_ON (FOCUS_OFF for the holder). */
    function updateCurrent(sy: number) {
      const grown = leaves.filter((l) => l.li.hasAttribute('data-grown'));
      let next = -1;
      for (const l of grown) {
        const centre = docOffset(l.card).y + l.card.offsetHeight / 2;
        const line = sy + H * (l.index === focusIdx ? FOCUS_OFF : FOCUS_ON);
        if (centre <= line) next = l.index;
      }
      if (next < 0 && grown.length) next = grown[0].index; // the only card out so far
      focusIdx = escaped ? next : -1;
      current = focusIdx;
      for (const l of leaves) {
        const on = l.index === focusIdx;
        l.card.toggleAttribute('data-active', on);
        l.li.toggleAttribute('data-focus', on);
      }
    }

    function step(dt: number, sy: number, instant: boolean) {
      const readY = readLine(sy);
      const leaving = !escaped && readY > escStart();
      if (leaving) escape(sy, instant);
      updateReached(sy);

      if (escaped && path) {
        const target = targetU(readY, sy);
        if (leaving && !instant) {
          // Hold the head exactly on the loop's head for the handoff frame; it moves off next frame.
        } else if (reduceMotion || instant) {
          u = target;
          uv = 0;
        } else {
          const n = 6;
          const h = dt / n;
          for (let i = 0; i < n; i++) {
            uv += (OMEGA * OMEGA * (target - u) - 2 * OMEGA * uv) * h;
            uv = clamp(uv, -MAX_SPEED, MAX_SPEED);
            u += uv * h;
            if (u < 0) (u = 0), (uv = Math.max(0, uv));
          }
          if (Math.abs(target - u) < 0.5 && Math.abs(uv) < 8) (u = target), (uv = 0); // settle exactly
        }
        u = Math.min(u, path.L + (yEnd - y0));
        visitedU = Math.max(visitedU, u);
        if (u > path.L) spineVisited = Math.max(spineVisited, y0 + (u - path.L));
        if (target === 0 && u < 0.5) rejoin();
      }

      growLeaves(dt, instant);
      updateCurrent(sy);
      place();
      draw(dt);
    }

    function frame(now: number) {
      const dt = lastT ? Math.min(0.05, (now - lastT) / 1000) : 1 / 60;
      lastT = now;
      // A jump (back/forward scroll restoration, anchor links, Home/End) moves more than 60% of the
      // viewport in one frame; it lands in place instead of racing the head along the whole path.
      const sy = window.scrollY;
      const jumped = Math.abs(sy - lastSy) > H * 0.6;
      lastSy = sy;
      step(dt, sy, jumped);
      raf = requestAnimationFrame(frame);
    }

    // ── Initial state: what the reader has already scrolled past is simply there ──────────
    measure();
    if (reduceMotion) spineVisited = yEnd;
    if (softNav) {
      try {
        const s = JSON.parse(sessionStorage.getItem(STATE_KEY) ?? 'null');
        if (s?.path === pagePath && Number.isFinite(s.spineVisited)) spineVisited = s.spineVisited;
      } catch {}
    }
    step(0, window.scrollY, true); // synchronous, so a page transition can morph from/to the head

    let remeasure = 0;
    const onResize = () => {
      clearTimeout(remeasure);
      remeasure = window.setTimeout(measure, 100);
    };
    const ro = new ResizeObserver(onResize);
    ro.observe(document.body);
    const onVisibility = () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
      } else if (!raf) {
        lastT = 0;
        raf = requestAnimationFrame(frame);
      }
    };
    document.addEventListener('visibilitychange', onVisibility);
    raf = requestAnimationFrame(frame);

    return () => {
      cancelAnimationFrame(raf);
      clearTimeout(remeasure);
      ro.disconnect();
      document.removeEventListener('visibilitychange', onVisibility);
      try {
        sessionStorage.setItem(STATE_KEY, JSON.stringify({ path: pagePath, spineVisited }));
      } catch {}
      for (const l of leaves) l.card.removeAttribute('data-active');
      shared.__phaseTracer = undefined;
    };
  }

  let cleanup: (() => void) | null = null;

  function mount() {
    if (cleanup) return;
    const home = document.querySelector<HTMLElement>('[data-home]');
    const tree = document.querySelector<HTMLElement>('[data-tree]');
    const svg = document.querySelector<SVGSVGElement>('[data-tree-svg]');
    const tracer = document.querySelector<HTMLElement>('[data-tree-tracer]');
    if (!home || !tree || !svg || !tracer) return;
    cleanup = run(home, tree, svg, tracer);
  }

  // after-swap as well as page-load: the head must be in place before a page transition snapshots.
  document.addEventListener('astro:after-swap', mount);
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
