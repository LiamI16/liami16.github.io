---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <canvas id="dot-field" aria-hidden="true" transition:persist></canvas>
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<script>
  const canvas = document.getElementById('dot-field') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  // Guard against re-init: the canvas is transition:persist'd across page
  // navigations, but this script tag re-executes on each navigation.
  if (canvas && ctx && !canvas.dataset.dotFieldInit) {
    canvas.dataset.dotFieldInit = 'true';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SPACING = 26;
    const RADIUS = 1.15;
    const BASE_ALPHA = 0.06;
    const MAX_ALPHA = 0.18;
    const REACT_RADIUS = 110;
    const MAX_PUSH = 4;
    const HOT_MULTIPLIER = 1.9;
    const HOT_SELECTOR = '[data-dot-hot]';

    const WAVE_SPEED = 1.0; // px/ms
    const WAVE_BAND = 150;
    const WAVE_BOOST = 0.5;
    const WAVE_MIN_COVER_MS = 460;
    const WAVE_DECAY_MS = 300; // exponential amplitude decay time constant — fast, dies right after the first bounce
    const WAVE_LIFETIME_MS = 1500; // total time the wave keeps bouncing before it stops

    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let width = 0;
    let height = 0;
    let dots: { x: number; y: number; ox: number; oy: number }[] = [];
    let mouse = { x: -9999, y: -9999 };
    let intensityTarget = 1;
    let intensity = 1;
    let rafId = 0;
    let navWave: { active: boolean; x: number; y: number; start: number } = {
      active: false,
      x: 0,
      y: 0,
      start: 0,
    };

    function layout() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      canvas!.style.width = width + 'px';
      canvas!.style.height = height + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      dots = [];
      for (let x = SPACING / 2; x < width; x += SPACING) {
        for (let y = SPACING / 2; y < height; y += SPACING) {
          dots.push({ x, y, ox: 0, oy: 0 });
        }
      }
    }

    function draw() {
      intensity += (intensityTarget - intensity) * 0.1;
      ctx!.clearRect(0, 0, width, height);

      const waveElapsed = navWave.active ? performance.now() - navWave.start : -1;
      const waveR = waveElapsed >= 0 ? waveElapsed * WAVE_SPEED : -1;
      const waveEnvelope = waveElapsed >= 0 ? Math.exp(-waveElapsed / WAVE_DECAY_MS) : 0;

      // Method of images: a wave reflecting off a wall looks identical to a
      // wave arriving from the source's mirror image beyond that wall. Mirror
      // the click point across each of the 4 edges (3 positions per axis —
      // itself, and one reflection off each wall) and check all 9
      // combinations, which covers direct + single-wall + corner bounces.
      const xImages = waveR >= 0 ? [navWave.x, 2 * width - navWave.x, -navWave.x] : [];
      const yImages = waveR >= 0 ? [navWave.y, 2 * height - navWave.y, -navWave.y] : [];

      for (const d of dots) {
        const dx = d.x - mouse.x;
        const dy = d.y - mouse.y;
        const dist = Math.hypot(dx, dy);
        let targetOx = 0;
        let targetOy = 0;
        let alpha = BASE_ALPHA;

        if (dist < REACT_RADIUS) {
          const t = 1 - dist / REACT_RADIUS;
          const eased = t * t;
          const push = eased * MAX_PUSH * intensity;
          const nx = dist === 0 ? 0 : dx / dist;
          const ny = dist === 0 ? 0 : dy / dist;
          targetOx = nx * push;
          targetOy = ny * push;
          alpha = BASE_ALPHA + eased * (MAX_ALPHA - BASE_ALPHA) * intensity;
        }

        if (waveR >= 0 && waveEnvelope > 0.015) {
          let waveAlpha = 0;
          for (const xi of xImages) {
            for (const yi of yImages) {
              const wdist = Math.hypot(d.x - xi, d.y - yi);
              const delta = Math.abs(wdist - waveR);
              if (delta < WAVE_BAND) {
                const wt = 1 - delta / WAVE_BAND;
                const smooth = wt * wt * (3 - 2 * wt); // smoothstep — soft gradient, not a hard ramp
                waveAlpha = Math.max(waveAlpha, smooth);
              }
            }
          }
          alpha = Math.max(alpha, waveAlpha * WAVE_BOOST * waveEnvelope);
        }

        d.ox += (targetOx - d.ox) * 0.18;
        d.oy += (targetOy - d.oy) * 0.18;

        ctx!.beginPath();
        ctx!.fillStyle = `rgba(23, 23, 20, ${alpha.toFixed(3)})`;
        ctx!.arc(d.x + d.ox, d.y + d.oy, RADIUS, 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    let waveToken = 0;

    async function triggerNavRipple(x: number, y: number, href: string) {
      // Tag this wave so a stale timeout from an earlier (possibly
      // aborted-by-a-newer-click) navigation can't kill a wave that
      // superseded it — otherwise clicking again within WAVE_LIFETIME_MS
      // of the previous click gets its ripple cut off almost immediately.
      const token = ++waveToken;
      navWave = { active: true, x, y, start: performance.now() };
      const minCover = new Promise((resolve) => setTimeout(resolve, WAVE_MIN_COVER_MS));
      try {
        const { navigate } = await import('astro:transitions/client');
        await Promise.all([minCover, navigate(href)]);
      } catch {
        // navigate() rejects if a newer navigation aborted this one — fine,
        // the newer triggerNavRipple call already owns navWave.
      } finally {
        setTimeout(() => {
          if (token === waveToken) navWave.active = false;
        }, WAVE_LIFETIME_MS);
      }
    }

    function loop() {
      draw();
      rafId = requestAnimationFrame(loop);
    }

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      const hot = document.elementFromPoint(e.clientX, e.clientY)?.closest(HOT_SELECTOR);
      intensityTarget = hot ? HOT_MULTIPLIER : 1;
    });
    window.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
      intensityTarget = 1;
    });
    window.addEventListener('resize', layout);

    if (!reduceMotion) {
      // Capture phase + stopImmediatePropagation: ClientRouter has its own
      // bubble-phase click listener that preventDefault()s and navigates on
      // its own. Running in capture lets us claim the click first and stop
      // it from ever reaching Astro's listener, so we fully own navigation
      // instead of racing (and losing) against it.
      document.addEventListener(
        'click',
        (e: MouseEvent) => {
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const anchor = (e.target as HTMLElement)?.closest?.('a[href]') as HTMLAnchorElement | null;
          if (!anchor || anchor.target === '_blank' || anchor.hasAttribute('download')) return;

          let url: URL;
          try {
            url = new URL(anchor.getAttribute('href')!, window.location.href);
          } catch {
            return;
          }
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname) return; // in-page anchors, no ripple

          e.preventDefault();
          e.stopImmediatePropagation();
          triggerNavRipple(e.clientX, e.clientY, url.href);
        },
        { capture: true },
      );
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else if (!reduceMotion) {
        rafId = requestAnimationFrame(loop);
      }
    });

    layout();
    if (reduceMotion) {
      draw();
    } else {
      loop();
    }
  }
</script>
