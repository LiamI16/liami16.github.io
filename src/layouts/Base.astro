---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <canvas id="dot-field" aria-hidden="true" transition:persist></canvas>
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<script>
  const canvas = document.getElementById('dot-field') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  // Astro runs this module once per session (it skips already-executed scripts on
  // client-side navigation) and the canvas is transition:persist'd, so this is a
  // one-time setup. The flag only guards against dev HMR re-running the module.
  if (canvas && ctx && !canvas.dataset.dotFieldInit) {
    canvas.dataset.dotFieldInit = 'true';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SPACING = 26;
    const RADIUS = 1.3;
    const BASE_ALPHA = 0.12;
    const MAX_ALPHA = 0.3;
    const REACT_RADIUS = 110;
    const MAX_PUSH = 4;
    const HOT_MULTIPLIER = 1.9;
    const HOT_SELECTOR = '[data-dot-hot]';

    const WAVE_SPEED = 1.0; // px/ms
    const WAVE_BAND = 150;
    const WAVE_BOOST = 0.5;
    const WAVE_DECAY_MS = 450; // exponential amplitude decay time constant
    const WAVE_LIFETIME_MS = 2000;

    // Dots are batched by quantized alpha so a frame is ~32 fill() calls instead of
    // one per dot, with no per-dot color-string allocation.
    const ALPHA_LEVELS = 32;
    const MAX_DRAW_ALPHA = 0.5;
    const TAU = Math.PI * 2;
    const fills = Array.from(
      { length: ALPHA_LEVELS + 1 },
      (_, i) => `rgba(23, 23, 20, ${((i / ALPHA_LEVELS) * MAX_DRAW_ALPHA).toFixed(3)})`,
    );
    const buckets: number[][] = Array.from({ length: ALPHA_LEVELS + 1 }, () => []);

    let dpr = 1;
    let width = 0;
    let height = 0;
    let dots: { x: number; y: number; ox: number; oy: number }[] = [];
    const mouse = { x: -9999, y: -9999 };
    let intensityTarget = 1;
    let intensity = 1;
    let rafId = 0;
    let wave = { x: 0, y: 0, start: -Infinity };

    function layout() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      canvas!.style.width = width + 'px';
      canvas!.style.height = height + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      dots = [];
      for (let x = SPACING / 2; x < width; x += SPACING) {
        for (let y = SPACING / 2; y < height; y += SPACING) {
          dots.push({ x, y, ox: 0, oy: 0 });
        }
      }
    }

    function draw(now: number) {
      intensity += (intensityTarget - intensity) * 0.1;

      const waveElapsed = now - wave.start;
      const waveEnvelope = waveElapsed < WAVE_LIFETIME_MS ? Math.exp(-waveElapsed / WAVE_DECAY_MS) : 0;
      const waveOn = waveEnvelope > 0.015;
      const waveR = waveElapsed * WAVE_SPEED;

      // Method of images: a wave reflecting off a wall looks identical to one
      // arriving from the source's mirror image beyond that wall. Mirroring the
      // click point across each edge (3 positions per axis) and checking all 9
      // combinations covers the direct wave plus single-wall and corner bounces.
      const xImages = [wave.x, 2 * width - wave.x, -wave.x];
      const yImages = [wave.y, 2 * height - wave.y, -wave.y];

      for (const bucket of buckets) bucket.length = 0;

      for (const d of dots) {
        const dx = d.x - mouse.x;
        const dy = d.y - mouse.y;
        const dist = Math.hypot(dx, dy);
        let targetOx = 0;
        let targetOy = 0;
        let alpha = BASE_ALPHA;

        if (dist < REACT_RADIUS) {
          const t = 1 - dist / REACT_RADIUS;
          const eased = t * t;
          const push = eased * MAX_PUSH * intensity;
          const nx = dist === 0 ? 0 : dx / dist;
          const ny = dist === 0 ? 0 : dy / dist;
          targetOx = nx * push;
          targetOy = ny * push;
          alpha = BASE_ALPHA + eased * (MAX_ALPHA - BASE_ALPHA) * intensity;
        }

        if (waveOn) {
          let waveAlpha = 0;
          for (const xi of xImages) {
            for (const yi of yImages) {
              const delta = Math.abs(Math.hypot(d.x - xi, d.y - yi) - waveR);
              if (delta < WAVE_BAND) {
                const wt = 1 - delta / WAVE_BAND;
                waveAlpha = Math.max(waveAlpha, wt * wt * (3 - 2 * wt)); // smoothstep edge
              }
            }
          }
          alpha = Math.max(alpha, waveAlpha * WAVE_BOOST * waveEnvelope);
        }

        d.ox += (targetOx - d.ox) * 0.18;
        d.oy += (targetOy - d.oy) * 0.18;

        const level = Math.min(ALPHA_LEVELS, Math.round((alpha / MAX_DRAW_ALPHA) * ALPHA_LEVELS));
        buckets[level].push(d.x + d.ox, d.y + d.oy);
      }

      ctx!.clearRect(0, 0, width, height);
      for (let i = 1; i <= ALPHA_LEVELS; i++) {
        const pts = buckets[i];
        if (!pts.length) continue;
        ctx!.fillStyle = fills[i];
        ctx!.beginPath();
        for (let j = 0; j < pts.length; j += 2) {
          ctx!.moveTo(pts[j] + RADIUS, pts[j + 1]);
          ctx!.arc(pts[j], pts[j + 1], RADIUS, 0, TAU);
        }
        ctx!.fill();
      }
    }

    function frame(now: number) {
      draw(now);
      rafId = requestAnimationFrame(frame);
    }

    function startLoop() {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(frame);
    }

    function updateHot() {
      const hot = mouse.x < 0 ? null : document.elementFromPoint(mouse.x, mouse.y)?.closest(HOT_SELECTOR);
      intensityTarget = hot ? HOT_MULTIPLIER : 1;
    }

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      updateHot();
    });
    // mouseleave isn't dispatched to window; the root element is what the pointer
    // actually leaves when it exits the viewport.
    document.documentElement.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
      intensityTarget = 1;
    });
    // Content moves under a stationary cursor when scrolling or swapping pages.
    window.addEventListener('scroll', updateHot, { passive: true });
    document.addEventListener('astro:page-load', updateHot);
    window.addEventListener('resize', () => {
      layout();
      if (reduceMotion) draw(performance.now());
    });

    if (!reduceMotion) {
      // Only starts the ripple — ClientRouter's own click handler still performs the
      // navigation. Capture phase runs before that handler calls preventDefault(), and
      // the checks mirror its own so the ripple fires only for clicks it will handle.
      document.addEventListener(
        'click',
        (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const anchor = (e.target as Element | null)?.closest?.('a[href]');
          if (!(anchor instanceof HTMLAnchorElement)) return;
          if (anchor.dataset.astroReload !== undefined || anchor.hasAttribute('download')) return;
          if (anchor.target && anchor.target !== '_self') return;
          const url = new URL(anchor.href);
          if (url.origin !== location.origin) return;
          if (url.pathname === location.pathname && url.search === location.search) return;

          let x = e.clientX;
          let y = e.clientY;
          if (e.detail === 0) {
            // Keyboard activation reports (0, 0); start from the link instead.
            const rect = anchor.getBoundingClientRect();
            x = rect.left + rect.width / 2;
            y = rect.top + rect.height / 2;
          }
          wave = { x, y, start: performance.now() };
        },
        { capture: true },
      );
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(rafId);
      else if (!reduceMotion) startLoop();
    });

    layout();
    if (reduceMotion) draw(performance.now());
    else startLoop();
  }
</script>
