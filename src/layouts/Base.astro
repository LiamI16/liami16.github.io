---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionTracker from '../components/SectionTracker.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to a 1200×630 social preview. */
  image?: string;
  /** Show the reading-progress rule under the header. */
  progress?: boolean;
}

const { title, description, image = '/og.png', progress = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..600&family=Geist+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&display=swap"
    />

    <script is:inline>
      // Runs before first paint and again on every client-side navigation
      // (ClientRouter replaces <html> attributes), so theme and motion
      // preferences never flash back to defaults.
      (() => {
        const read = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const apply = (doc) => {
          const stored = read('theme');
          const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          doc.documentElement.dataset.theme = dark ? 'dark' : 'light';
          const easing = read('motion-easing');
          if (easing) doc.documentElement.style.setProperty('--ease-spring', easing);
        };
        apply(document);
        if (!window.__prefsBound) {
          window.__prefsBound = true;
          document.addEventListener('astro:before-swap', (e) => {
            apply(e.newDocument);
            e.newDocument.documentElement.dataset.softNav = '';
          });
        }
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header progress={progress} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SectionTracker />
  </body>
</html>
