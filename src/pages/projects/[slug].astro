---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, stack, cover, coverAlt, repo, demo } = project.data;
---

<Base title={`${title} · Liam Imagawa`} description={summary}>
  <article>
    <h1>{title}</h1>
    <p>{summary}</p>
    <p>{stack.join(' · ')}</p>
    <p>
      {repo && <a href={repo}>Source</a>}
      {demo && <a href={demo}>Live demo</a>}
    </p>
    <Image src={cover} alt={coverAlt} widths={[400, 800, 1200]} sizes="(max-width: 700px) 100vw, 700px" />
    <Content />
  </article>
</Base>
