---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
    (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined },
  }));
}

const { project, next } = Astro.props;
const { Content, headings } = await render(project);
const { title, summary, stack, cover, coverAlt, repo, demo, draft, category, status, date } = project.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const ogImage = cover.format === 'svg' ? undefined : (await getImage({ src: cover, width: 1200, format: 'png' })).src;
---

<Base title={`${title} — Liam Imagawa`} description={summary} image={ogImage} progress>
  <article class="article" id="article">
    <header class="head">
      <a class="back mono" href="/#work">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3m4.5-4.5L3 8l4.5 4.5"></path></svg>
        All work
      </a>

      <p class="mono meta-line fade-up" style="--i: 0">
        {category && <span>{category}</span>}
        <span>{date.getFullYear()}</span>
        {status && <span class="status-dot">{status}</span>}
        {draft && <span class="draft">Draft — still in progress</span>}
      </p>

      <h1>{title}</h1>
      <p class="summary fade-up" style="--i: 1">{summary}</p>

      <div class="facts fade-up" style="--i: 2">
        <p class="mono stack">{stack.join(' / ')}</p>
        {
          (repo || demo) && (
            <p class="actions">
              {demo && (
                <a class="pill primary" href={demo}>
                  Live demo <span aria-hidden="true">↗</span>
                </a>
              )}
              {repo && (
                <a class="pill" href={repo}>
                  Source <span aria-hidden="true">↗</span>
                </a>
              )}
            </p>
          )
        }
      </div>
    </header>

    <figure class="cover">
      <Image class="glow" src={cover} alt="" widths={[128]} sizes="128px" aria-hidden="true" />
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 1100, 1600]}
        sizes="(min-width: 72rem) 67rem, 100vw"
        loading="eager"
        data-vt-cover={project.id}
        style="view-transition-class: vt-cover"
      />
    </figure>

    <div class="layout">
      <div class="prose">
        <Content />
      </div>

      {
        toc.length > 1 && (
          <aside class="toc" aria-label="On this page">
            <p class="mono toc-title">On this page</p>
            <ol>
              {toc.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`} data-toc-link={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </article>

  {
    next && (
      <div class="tone">
      <nav class="wrap next" aria-label="Next project">
        <a href={`/projects/${next.id}/`}>
          <span class="mono label">Next project</span>
          <span class="next-title">{next.data.title}</span>
          <span class="mono next-summary">{next.data.category ?? next.data.stack.slice(0, 3).join(' / ')}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </nav>
      </div>
    )
  }
</Base>

<style>
  /* One centred reading column; the header may run wider to the right, the
     cover wider on both sides, and the TOC sits in the right margin. */
  .article {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [col-start] minmax(0, var(--measure))
      [col-end] minmax(var(--gutter), 1fr) [full-end];
  }

  @media (min-width: 1100px) {
    .article {
      grid-template-columns:
        [full-start] minmax(var(--gutter), 1fr)
        [col-start] minmax(0, var(--measure))
        [col-end] minmax(18rem, 1fr) [full-end];
    }
  }

  .head {
    grid-column: col-start / full-end;
    max-width: min(100%, 56rem);
    padding-right: var(--gutter);
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .back svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur) var(--ease-spring);
  }

  .back:hover {
    color: var(--ink);
  }

  .back:hover svg {
    transform: translateX(-3px);
  }

  .meta-line {
    margin: 0 0 1.25rem;
  }

  .draft {
    color: var(--accent);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 1.5rem;
  }

  .summary {
    max-width: 44rem;
    margin: 0 0 2rem;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .stack {
    margin: 0;
    color: var(--muted);
  }

  .actions {
    display: flex;
    gap: 0.6rem;
    margin: 0;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-spring);
  }

  .pill:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }

  .pill.primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .pill.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .cover {
    grid-column: full-start / full-end;
    position: relative;
    isolation: isolate;
    width: min(calc(100% - 2 * var(--gutter)), calc(var(--measure) + 28rem));
    margin: clamp(2.5rem, 6vw, 4rem) auto;
  }

  .cover :global(.glow) {
    position: absolute;
    inset: 8% 4% -3%;
    width: 92%;
    height: 95%;
    object-fit: cover;
    z-index: -1;
    filter: blur(64px) saturate(1.5);
    opacity: var(--card-glow);
    border: 0;
    box-shadow: none;
    pointer-events: none;
  }

  .cover :global(img:not(.glow)) {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    background: var(--surface);
  }

  .layout {
    grid-column: col-start / col-end;
  }

  .toc {
    display: none;
  }

  @media (min-width: 1100px) {
    .layout {
      grid-column: col-start / full-end;
      display: grid;
      grid-template-columns: subgrid;
    }

    .toc {
      display: block;
      position: sticky;
      top: 6rem;
      align-self: start;
      width: min(15rem, calc(100% - 3rem));
      margin-left: 3rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
    }
  }

  .toc-title {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .toc li a {
    position: relative;
    display: block;
    padding: 0.3rem 0 0.3rem 1rem;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .toc li.depth-3 a {
    padding-left: 1.75rem;
    font-size: 0.8rem;
  }

  .toc li a::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.3rem;
    bottom: 0.3rem;
    width: 1px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform var(--dur) var(--ease-spring);
  }

  .toc li a:hover {
    color: var(--ink);
  }

  .toc li a[aria-current='true'] {
    color: var(--ink);
  }

  .toc li a[aria-current='true']::before {
    transform: scaleY(1);
  }

  .next {
    margin-top: clamp(4rem, 10vw, 7rem);
  }

  .next a {
    position: relative;
    display: grid;
    gap: 0.4rem;
    padding: clamp(2rem, 5vw, 3rem) 4rem clamp(2rem, 5vw, 3rem) 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .label,
  .next-summary {
    color: var(--muted);
  }

  .next-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .next svg {
    position: absolute;
    right: 0;
    top: 50%;
    width: 2rem;
    height: 2rem;
    margin-top: -1rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      transform var(--dur) var(--ease-spring),
      stroke var(--dur-fast) var(--ease-out);
  }

  .next a:hover .next-title {
    color: var(--accent);
  }

  .next a:hover svg {
    stroke: var(--accent);
    transform: translateX(6px);
  }
</style>

<script>
  let article: HTMLElement | null = null;
  let header: HTMLElement | null = null;

  function updateProgress() {
    if (!article || !header) return;
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const pct = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
    header.style.setProperty('--progress', pct.toFixed(4));
  }

  // Highlight the section being read: the last heading whose midline has crossed 38% of the
  // viewport (the last one at the page bottom). Computed from positions on every scroll, so it
  // stays right after jumps (TOC clicks, scrollbar drags) that a scroll-band observer misses.
  let tocFrame = 0;

  function updateToc() {
    tocFrame = 0;
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (!links.length) return;
    const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
    let id: string | null = null;
    links.forEach((a) => {
      const h = document.getElementById(a.dataset.tocLink!);
      if (!h) return;
      const r = h.getBoundingClientRect();
      if (atBottom || r.top + r.height / 2 <= window.innerHeight * 0.38) id = a.dataset.tocLink!;
    });
    links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.tocLink === id)));
  }

  const scheduleToc = () => {
    if (!tocFrame) tocFrame = requestAnimationFrame(updateToc);
  };

  document.addEventListener('astro:page-load', () => {
    article = document.getElementById('article');
    header = document.querySelector('[data-site-header]');
    updateProgress();
    updateToc();
  });

  const w = window as typeof window & { __progressBound?: boolean };
  if (!w.__progressBound) {
    w.__progressBound = true;
    document.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    document.addEventListener('scroll', scheduleToc, { passive: true });
    window.addEventListener('resize', scheduleToc);
  }
</script>
