---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PhasePortrait from '../components/PhasePortrait.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Liam Imagawa — Systems & controls engineer"
  description="Long-form write-ups on control theory, robotics, and generative systems projects by Liam Imagawa."
>
  <section class="hero" data-pp-surface>
    <PhasePortrait />

    <div class="wrap hero-grid">
      <div class="intro">
        <p class="mono eyebrow fade-up" style="--i: 0">Systems &amp; controls engineer</p>
        <h1>
          <span class="rise"><span style="--i: 1">Liam</span></span>
          <span class="rise"><span style="--i: 2">Imagawa</span></span>
        </h1>
        <p class="lede fade-up" style="--i: 3">
          Student engineer working across control theory and generative systems. Currently: collision risk under
          uncertainty, and a music engine that never repeats.
        </p>
        <p class="cta fade-up" style="--i: 4">
          <a href="#work" class="button">
            Selected work
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5"></path></svg>
          </a>
          <a href="mailto:liamimagawa@gmail.com" class="link">Get in touch</a>
        </p>
      </div>

      <figure class="figure" data-pp-anchor>
        <figcaption class="mono fade-up" style="--i: 5">
          <span class="fig-title">Fig. 0 — Van der Pol oscillator, μ = 1</span>
          <span class="fig-hint"><span class="pointer-fine">Move to perturb · click to kick</span><span
              class="pointer-coarse">Tap to kick the state</span
            ></span>
          <span class="readout" data-pp-readout aria-hidden="true">x +0.35   ẋ +0.00</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="tone">
  <section id="work" class="wrap work" aria-labelledby="work-title">
    <header class="work-head">
      <h2 id="work-title">Selected work</h2>
      <p class="mono count">({String(projects.length).padStart(2, '0')})</p>
      <p class="work-note">
        Long-form companions to the résumé — the reasoning behind a design, the theorem behind a proof, the part that
        actually took the time.
      </p>
    </header>

    {
      projects.length > 0 ? (
        <div class="grid">
          {projects.map((project, i) => (
            <ProjectCard project={project} index={i} />
          ))}
        </div>
      ) : (
        <p class="mono empty">Write-ups are in progress — check back soon.</p>
      )
    }
  </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    margin-top: -4rem; /* slide under the sticky header */
    padding-top: 4rem;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    /* A soft pool of light behind the figure. */
    background: radial-gradient(ellipse 45% 55% at 72% 52%, var(--spotlight), transparent 100%);
  }

  @media (max-width: 699px) {
    .hero {
      background: radial-gradient(ellipse 80% 30% at 50% 78%, var(--spotlight), transparent 100%);
    }
  }

  .hero-grid {
    position: relative;
    display: grid;
    /* Height follows the window, so short laptop screens still show the CTA and caption. */
    min-height: clamp(34rem, calc(100svh - 4rem), 64rem);
    padding-block: clamp(2rem, 7svh, 6rem) 2rem;
    /* Distance from the content edge to the viewport edge, for the full-bleed figure. */
    --bleed: max(var(--gutter), calc((100vw - var(--page)) / 2 + var(--gutter)));
  }

  @media (min-width: 700px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
    }
  }

  .intro {
    position: relative;
    z-index: 1;
    align-self: center;
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: var(--accent);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    /* Bounded by width, height, and the text column (page width) so the name never clips. */
    font-size: clamp(3.6rem, min(11vw, 16svh, calc(var(--page) * 0.12)), 12rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    margin: 0 0 2rem;
  }

  .lede {
    max-width: 30rem;
    margin: 0 0 2.25rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.15rem 0.7rem 1.3rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      transform var(--dur) var(--ease-spring),
      background-color var(--dur-fast) var(--ease-out);
  }

  .button svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur) var(--ease-spring);
  }

  .button:hover {
    background: var(--accent);
    transform: translateY(-2px);
  }

  .button:hover svg {
    transform: translateY(2px);
  }

  .cta .link {
    color: var(--ink);
    font-weight: 500;
  }

  /* The phase portrait centres its limit cycle in this box. */
  .figure {
    position: relative;
    margin: 0;
    min-height: 24rem;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  @media (min-width: 700px) {
    /* Bleed to the viewport's right edge so the portrait grows with the window;
       padding keeps the caption aligned with the content edge. */
    .figure {
      align-self: stretch;
      min-height: 0;
      margin-right: calc(-1 * var(--bleed));
      padding-right: var(--bleed);
    }
  }

  figcaption {
    display: grid;
    gap: 0.15rem;
    text-align: right;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.5;
    transform: translateY(0.5rem);
  }

  .fig-title {
    color: var(--ink-soft);
  }

  .readout {
    color: var(--accent);
    white-space: pre;
  }

  .pointer-coarse {
    display: none;
  }

  @media (pointer: coarse) {
    .pointer-fine {
      display: none;
    }

    .pointer-coarse {
      display: inline;
    }
  }

  .work {
    padding-top: clamp(4rem, 10vw, 7rem);
    scroll-margin-top: 3rem;
  }

  .work-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 0.75rem;
    row-gap: 1rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .work-head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .count {
    margin: 0;
    color: var(--muted);
  }

  .work-note {
    grid-column: 1 / -1;
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .work-head {
      grid-template-columns: auto auto 1fr;
    }

    .work-note {
      grid-column: 3;
      justify-self: end;
      max-width: 26rem;
      text-align: right;
    }
  }

  .grid {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    /* Offset the second column for an editorial rhythm, once cards are wide enough. */
    .grid > :global(:nth-child(even)) {
      margin-top: 5rem;
    }
  }

  .empty {
    color: var(--muted);
  }
</style>
