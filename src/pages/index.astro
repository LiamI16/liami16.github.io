---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Liam Imagawa" description="Projects and write-ups by Liam Imagawa.">
  <div class="layout">
    <aside class="sidebar">
      <div>
        <h1>Liam Imagawa</h1>
        <p class="role">Systems &amp; controls engineer</p>
        <p class="bio">
          Long-form write-ups on the projects behind the résumé — the reasoning behind a
          design, the theorem behind a proof, the part that actually took the time.
        </p>

        <nav class="section-nav" aria-label="Section">
          <ul>
            <li>
              <a href="#about" class="active" data-dot-hot
                ><span class="nav-indicator"></span><span class="nav-label">About</span></a
              >
            </li>
            <li>
              <a href="#projects" data-dot-hot
                ><span class="nav-indicator"></span><span class="nav-label">Projects</span></a
              >
            </li>
          </ul>
        </nav>
      </div>

      <div class="links">
        <a href="/resume.pdf">Résumé</a>
        <a href="https://github.com/LiamI16">GitHub</a>
      </div>
    </aside>

    <div class="content">
      <section id="about" class="about">
        <h2 class="eyebrow">About</h2>
        <p>
          I'm a student engineer working across control theory and generative systems. This
          site is the in-depth companion to the résumé.
        </p>
      </section>

      <section id="projects">
        <h2 class="eyebrow">Projects</h2>
        <div class="plist">
          {
            projects.map((project) => (
              <article class="prow" data-dot-hot>
                <a class="thumb" href={`/projects/${project.id}/`} tabindex="-1" aria-hidden="true">
                  <Image src={project.data.cover} alt="" widths={[300, 600]} sizes="(min-width: 640px) 240px, 100vw" />
                </a>
                <div>
                  <p class="meta">
                    {project.data.stack.slice(0, 3).join(' · ')}
                    {project.data.draft && ' · Draft'}
                  </p>
                  <h3>
                    <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                  </h3>
                  <p class="desc">{project.data.summary}</p>
                  <a class="ext-link" href={`/projects/${project.id}/`}>
                    Read more
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .layout {
    max-width: 1180px;
    margin-inline: auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 1024px) {
    .layout {
      display: flex;
      gap: 3rem;
      align-items: flex-start;
    }
  }

  .sidebar {
    padding: 3rem 0;
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 0;
      width: 40%;
      max-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 6rem 0;
      border-right: 1px solid var(--line);
    }
  }

  .sidebar h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 0.6rem;
  }

  .sidebar .role {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin: 0 0 1.1rem;
  }

  .sidebar .bio {
    max-width: 34ch;
    font-size: 0.94rem;
    color: var(--muted);
    margin: 0;
  }

  nav.section-nav {
    margin-top: 3rem;
    display: none;
  }

  @media (min-width: 1024px) {
    nav.section-nav {
      display: block;
    }
  }

  nav.section-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav.section-nav a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0;
    text-decoration: none;
    outline-offset: 4px;
  }

  .nav-indicator {
    height: 1px;
    width: 2rem;
    background: var(--line);
    transition: all 0.25s ease;
  }

  .nav-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.25s ease;
  }

  nav.section-nav a:hover .nav-indicator,
  nav.section-nav a.active .nav-indicator {
    width: 3.5rem;
    background: var(--ink);
  }

  nav.section-nav a:hover .nav-label,
  nav.section-nav a.active .nav-label {
    color: var(--ink);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2.5rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .links {
      margin-top: 0;
    }
  }

  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.1rem;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
  }

  .content {
    padding: 3rem 0 6rem;
  }

  @media (min-width: 1024px) {
    .content {
      width: 60%;
      padding-top: 6rem;
    }
  }

  section {
    margin-bottom: 4rem;
  }

  section > .eyebrow {
    display: block;
    margin: 0 0 1.5rem;
  }

  .about p {
    max-width: 58ch;
    margin: 0;
  }

  .plist {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .plist:hover .prow:not(:hover) {
    opacity: 0.6;
  }

  .prow {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1.25rem;
    margin-inline: -1.25rem;
    border-radius: 8px;
    border: 1px solid transparent;
    transition:
      opacity 0.25s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .prow:not(:last-child) {
    border-bottom: 1px solid var(--line-soft);
  }

  .prow:hover,
  .prow:focus-within {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    border-color: var(--line);
    box-shadow: 0 10px 30px -20px rgba(23, 23, 20, 0.35);
  }

  @media (min-width: 640px) {
    .prow {
      grid-template-columns: 9rem 1fr;
      align-items: center;
      gap: 1.5rem;
    }
  }

  .prow .thumb {
    display: block;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 16 / 9;
  }

  .prow .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(55%) contrast(1.02);
    transition: filter 0.3s ease;
  }

  .prow:hover .thumb :global(img) {
    filter: grayscale(0%) contrast(1.02);
  }

  .prow .meta {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 0.35rem;
  }

  .prow h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
  }

  .prow h3 a {
    text-decoration: none;
  }

  .prow h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .prow p.desc {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0 0 0.75rem;
    max-width: 46ch;
  }

  .ext-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .ext-link svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .ext-link:hover svg,
  .ext-link:focus-visible svg {
    transform: translate(2px, -2px);
  }
</style>

<script>
  // Active section = the last one whose top has scrolled past 35% of the viewport.
  // (A narrow IntersectionObserver band marked Projects active at page load whenever
  // About was short enough to sit entirely above the band.)
  function updateActiveSection() {
    const sections = [...document.querySelectorAll<HTMLElement>('.content section[id]')];
    const links = document.querySelectorAll<HTMLAnchorElement>('.section-nav a');
    if (!sections.length || !links.length) return;

    const threshold = window.innerHeight * 0.35;
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= threshold) current = section;
    }
    const atBottom =
      window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom) current = sections[sections.length - 1];

    links.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${current.id}`));
  }

  // Module scripts run once per session under ClientRouter, so these attach once;
  // on non-home pages the query finds nothing and it returns early.
  document.addEventListener('astro:page-load', updateActiveSection);
  document.addEventListener('scroll', updateActiveSection, { passive: true });
  window.addEventListener('resize', updateActiveSection);
</script>
